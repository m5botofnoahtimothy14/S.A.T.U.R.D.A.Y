{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/sat/:path*", "destination": "/api/sat?path=:path*" }
  ],
  "functions": {
    "api/sat.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
