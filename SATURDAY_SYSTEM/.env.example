# SATURDAY production environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# FIREBASE_SERVICE_ACCOUNT=/secure/path/serviceAccount.json
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# FIREBASE_NODE_ID=saturday-node-01
# SATURDAY_TTS=auto
# PIPER_MODEL_PATH=
# SATURDAY_TTS_CLI=
# SATURDAY_TTS_VOLUME=80   # Windows voice 0-100
# SATURDAY_TTS_RATE=0      # Windows voice -10..10
