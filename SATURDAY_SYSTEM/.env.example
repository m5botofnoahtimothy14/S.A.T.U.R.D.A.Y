# SATURDAY v1.9 environment — copy to `.env` (NEVER commit; gitignored).
# Lines with values are live for this machine; blanks = fill when needed.

# Vercel HUD origin (required for phone/browser access via tunnel)
SATURDAY_CORS_ORIGIN=https://saturdayagenticai.vercel.app

# Keep the public tunnel up across drops (1 = on)
SATURDAY_SHARE_PERSIST=1
# Stable endpoint after `cloudflared tunnel login` (empty = rotating URL)
SATURDAY_SHARE_HOSTNAME=

# Local brain (Ollama, localhost)
OLLAMA_HOST=http://localhost:11434

# Ears (whisper model: tiny/small/base)
SATURDAY_STT_MODEL=tiny

# Voice (auto/piper/cli) + Windows voice knobs
SATURDAY_TTS=auto
# PIPER_MODEL_PATH=
# SATURDAY_TTS_CLI=
SATURDAY_TTS_VOLUME=80
SATURDAY_TTS_RATE=0

# HomeBot Core2 link (Mosquitto runs on this PC)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
HOMEBOT_BACKEND=auto
# HOMEBOT_COM_PORT=COM3

# Firebase cloud DB (free Spark, region asia-southeast1) — service file stays private
# FIREBASE_SERVICE_ACCOUNT=C:\secure\saturday-firebase.json
FIREBASE_DATABASE_URL=https://aegis-os-75256-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_NODE_ID=saturday-node
