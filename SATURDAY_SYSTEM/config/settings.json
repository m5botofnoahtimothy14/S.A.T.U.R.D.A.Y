{
    "system_name": "SATURDAY-PMV-UNIT-01",
    "version": "2.1.0",
    "security": {
        "auto_lock_timeout": 300,
        "encryption_algorithm": "Fernet/AES-128-CBC+HMAC",
        "kdf": "PBKDF2-HMAC-SHA256",
        "kdf_iterations": 100000
    },
    "paths": {
        "vault": "./vault",
        "blackbox": "./blackbox",
        "sync_staging": "./staging"
    },
    "sync": {
        "p2p_enabled": true,
        "backend": "syncthing"
    },
    "deadman": {
        "timeout_seconds": 604800,
        "enabled": true
    },
    "realtime": {
        "enabled": false,
        "publish_interval_seconds": 10
    },
    "logging": {
        "level": "INFO"
    },
    "audio": {
        "mic_device": "",
        "mic_gain": 2.0,
        "comment": "mic_device: '' = auto (WASAPI Realtek array first). Or index ('9') or name substring. Env SATURDAY_MIC_DEVICE overrides this."
    },
    "agent": {
        "allowed_apps": ["notepad", "calculator", "mspaint", "opera", "chrome", "firefox", "explorer", "settings"],
        "allowed_actions": [],
        "comment": "allowed_actions empty = all schema actions (destructive still needs YES-confirm). Kill switch: Ctrl+Alt+Shift+X or 'stop'."
    }
}
